# ─────────────────────────────────────────────────────────────────────────────
# SycoCode — environment template. Copy to `.env` and fill in secrets.
# `.env` is gitignored; NEVER commit real keys. This file (.env.example) is safe
# to commit because it contains no values.
# ─────────────────────────────────────────────────────────────────────────────

# ── Phase C model under evaluation (Cerebras) ──
# Get a key at https://cloud.cerebras.ai → API Keys. Paste it after the `=`.
CEREBRAS_API_KEY=

# ── Phase C LLM judge — W&B Inference / CoreWeave (DeepSeek-V4-Flash) ──
# Get a key at https://wandb.ai/authorize. Used by:
#   python -m eval.judge vcr --judge-provider wandb --reasoning-effort low ...
# (model defaults to deepseek-ai/DeepSeek-V4-Flash; base_url api.inference.wandb.ai)
WANDB_API_KEY=

# ── OpenRouter — current standard for the LLM judge (and anything except gpt-oss gen) ──
# Get a key at https://openrouter.ai/keys. Judge usage:
#   python -m eval.judge vcr --judge-provider openrouter --reasoning-effort low ...
# (model defaults to deepseek/deepseek-v4-flash; reasoning via {"reasoning":{"effort":"low"}})
OPENROUTER_API_KEY=

# ── Optional overrides (defaults already target Cerebras gpt-oss-120b, Developer tier) ──
# SYCO_PROVIDER=cerebras
# SYCO_BASE_URL=https://api.cerebras.ai/v1
# SYCO_API_MODEL_ID=gpt-oss-120b
# SYCO_LOGICAL_NAME=gpt-oss
# SYCO_API_KEY_VAR=CEREBRAS_API_KEY
# SYCO_MAX_TOKENS_PARAM=max_completion_tokens
# SYCO_TEMPERATURE=0.0
# SYCO_TOP_P=1.0
# SYCO_MAX_TOKENS=8192
# SYCO_SEED=7
# SYCO_CONCURRENCY=12
# SYCO_RPM=1000
# SYCO_TPM=1000000
# SYCO_MAX_RETRIES=6
# SYCO_TIMEOUT=120

