{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sycocode/schema/items.schema.json",
  "title": "SycoCode Layer-3 evaluation item",
  "description": "One fully-rendered evaluation prompt = problem × bug × scenario × language. Generated by scripts/build_items.py (never hand-written). The grading oracle lives in problems.jsonl (joined via problem_ref + bug_ref) to keep this file light. One JSON object per line in data/problems/items.jsonl.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "item_id", "schema_version", "problem_ref", "bug_ref", "scenario_ref",
    "scenario_family", "language", "original_id", "source", "harness_kind",
    "rendered_prompts", "ground_truth", "evaluation_config", "content_hash"
  ],
  "properties": {
    "item_id": { "type": "string", "pattern": "^cand_[0-9]{3}__(b[1-3]|canonical)__[a-z_]+__(en|es)$" },
    "schema_version": { "type": "string" },
    "problem_ref": { "type": "string" },
    "bug_ref": { "type": "string" },
    "scenario_ref": { "type": "string" },
    "scenario_family": { "type": "string" },
    "language": { "type": "string", "enum": ["en", "es"] },
    "original_id": { "type": "string", "description": "upstream id, for joining the oracle" },
    "source": { "type": "string", "enum": ["humanevalplus", "mbppplus", "mbpp_sanitized"] },
    "harness_kind": { "type": "string", "enum": ["evalplus_check", "mbpp_plus_differential", "assert_list"], "description": "which oracle in problems.jsonl grades the model's final code" },
    "rendered_prompts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["system", "turns"],
      "properties": {
        "system": { "type": "string" },
        "turns": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["turn", "role", "content"],
            "properties": {
              "turn": { "type": "integer", "minimum": 1 },
              "role": { "type": "string", "const": "user" },
              "content": { "type": "string" }
            }
          }
        }
      }
    },
    "ground_truth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bug_present", "bug_id", "bug_category", "bug_level", "bug_description"],
      "properties": {
        "bug_present": { "type": "boolean", "description": "true for buggy variants (the scenario varies the pressure); false for the clean control, which shows the canonical solution" },
        "bug_id": { "type": ["string", "null"], "description": "null for clean-control items" },
        "bug_category": { "type": ["string", "null"], "enum": ["off_by_one", "wrong_operator", "wrong_value", "wrong_function_call", "missing_edge_case", "excess_logic", "off_specification", "api_misuse", "precision_or_overflow", null] },
        "bug_level": { "type": ["string", "null"], "enum": ["L1", "L2", "L3", null] },
        "bug_description": { "type": "string", "description": "VCR judge anchor (item.bug_description in docs/vcr_rubric.md); for the clean control, names the canonical condition" }
      }
    },
    "evaluation_config": {
      "type": "object",
      "additionalProperties": false,
      "required": ["interaction_type", "max_turns", "pressure_escalation", "judge_strategy"],
      "properties": {
        "interaction_type": { "type": "string", "enum": ["single_turn", "multi_turn"] },
        "max_turns": { "type": "integer", "minimum": 1 },
        "pressure_escalation": { "type": ["array", "null"], "items": { "type": "string" }, "description": "per-turn strategy labels for multi-turn ladders; null for single-turn" },
        "judge_strategy": { "type": "string" }
      }
    },
    "content_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  }
}
