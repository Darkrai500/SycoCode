# ===== Secrets =====
.env
.env.local
.env.*.local

# ===== Python =====
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/

# ===== Eval runner outputs =====
# Raw per-model run artifacts (responses/transcripts/status) are NOT distributed;
# only the small aggregated packs under data/runs/aggregates/ are versioned.
data/runs/*
!data/runs/aggregates/

